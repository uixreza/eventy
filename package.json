{
  "name": "kooja",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env server.mjs",
    "build": "prisma generate && next build",
    "vercel-build": "npm run build",
    "start": "node --env-file=.env server.mjs --production",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed:admin": "node --env-file=.env scripts/seed-admin.mjs",
    "seed:events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-events.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^14.13.0",
    "jalaali-js": "^2.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "sileo": "^0.1.6",
    "ws": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
